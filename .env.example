FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here
UPLOAD_FOLDER=data/resumes
MAX_CONTENT_LENGTH=16777216
HOST=0.0.0.0
PORT=5000

# LLM — pick ONE provider
ENABLE_LLM=auto

# --- Google Gemini (native SDK via google-generativeai) ---
# Create a key in Google AI Studio or Cloud Console → APIs & Services → Credentials.
# Use either variable name (GEMINI_API_KEY is an alias for GOOGLE_API_KEY).
GOOGLE_API_KEY=your-google-api-key-here
# GEMINI_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.0-flash
# Optional: force OpenAI-compatible Gemini endpoint instead of native SDK
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# (requires OPENAI_API_KEY or LLM_API_KEY set alongside GOOGLE_API_KEY)

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- Ollama (local, free) ---
# OPENAI_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
